<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>FolderCleaner</AssemblyName>
    <RootNamespace>FolderCleaner</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Чистильщик папок</Product>
    <Description>Простое приложение для анализа и безопасной очистки выбранной папки</Description>
    <Company>FolderCleaner</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
