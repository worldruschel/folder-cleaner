<Window x:Class="FolderCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чистильщик папок"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Icon="Assets/app.ico"
        FontFamily="Segoe UI">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#0EA5E9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="✨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Чистильщик папок"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Выберите папку для анализа — приложение найдёт лишние файлы, дубликаты и пустые папки"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="42,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,6"
                        Margin="0,0,8,0">
                    <TextBlock Text="♻️ В Корзину"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#1E40AF" />
                </Border>
                <Button x:Name="CheckUpdatesButton"
                        Content="v1.0.2  🔄"
                        ToolTip="Проверить обновления на GitHub"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Click="CheckUpdatesButton_Click" />
                <Button x:Name="FeedbackButton"
                        Content="✉️"
                        ToolTip="Обратная связь (worldruschel@gmail.com)"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,6"
                        FontSize="12.5"
                        Margin="0,0,8,0"
                        Click="FeedbackButton_Click" />
                <Button x:Name="DonateButton"
                        Content="❤️"
                        ToolTip="Поддержать автора на Boosty"
                        Style="{StaticResource RowDeleteButton}"
                        Padding="10,6"
                        FontSize="12.5"
                        Click="DonateButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 1b. Update Banner (hidden until an update is available) -->
        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   Text="Доступна новая версия!"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#065F46" />
                        <TextBlock x:Name="UpdateBannerSubtitle"
                                   Text="Нажмите «Обновить сейчас» — приложение скачает и установит обновление автоматически."
                                   FontSize="12"
                                   Foreground="#047857"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="InstallUpdateButton"
                                Content="⬇  Обновить сейчас"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,7"
                                FontSize="12.5"
                                Margin="0,0,8,0"
                                Click="InstallUpdateButton_Click" />
                        <Button x:Name="DismissUpdateButton"
                                Content="Позже"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,7"
                                FontSize="12"
                                Click="DismissUpdateButton_Click" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar"
                             Visibility="Collapsed"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Margin="0,8,0,0"
                             Foreground="#059669"
                             Background="#D1FAE5"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- 2. Folder Selector + Start Button Card -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Folder Path Input -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,10,0">
                        <Grid>
                            <TextBox x:Name="FolderPathBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     FontSize="13.5"
                                     Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="FolderPathBox_TextChanged" />
                            <TextBlock x:Name="FolderPlaceholder"
                                       Text="Выберите папку, в которой нужно навести порядок..."
                                       Foreground="#94A3B8"
                                       FontSize="13.5"
                                       Padding="13,10"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="Выбрать папку..."
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="BrowseButton_Click" />

                    <Button x:Name="StartButton"
                            Grid.Column="2"
                            Content="▶  Старт"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="126"
                            Click="StartButton_Click" />
                </Grid>

                <!-- Quick Folder Chips -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Быстрый выбор:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Content="📥 Загрузки" Style="{StaticResource ChipButton}" Tag="Downloads" Click="QuickFolder_Click" />
                    <Button Content="🖥️ Рабочий стол" Style="{StaticResource ChipButton}" Tag="Desktop" Click="QuickFolder_Click" />
                    <Button Content="📄 Документы" Style="{StaticResource ChipButton}" Tag="Documents" Click="QuickFolder_Click" />
                    <Button Content="🗂️ Временные (Temp)" Style="{StaticResource ChipButton}" Tag="Temp" Click="QuickFolder_Click" />
                </StackPanel>

                <!-- Progress Bar (visible during scan or batch clean) -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock x:Name="ProgressStatusText"
                                   Text="Анализ папки..."
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="#1D4ED8" />
                        <TextBlock x:Name="ProgressCountText"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" />
                    </DockPanel>
                    <ProgressBar x:Name="MainProgressBar"
                                 Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBlue}"
                                 Background="#E2E8F0"
                                 BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Summary Cards + Filters (visible after scan) -->
        <StackPanel x:Name="SummarySection" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,12">
            <!-- 4 Metric Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Проверено файлов" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="StatScannedFiles" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatTotalSize" Text="Общий размер: 0 Б" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Рекомендаций к очистке" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="StatFoundCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatSelectedHint" Text="Выбрано: 0" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Можно освободить" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="StatReclaimable" Text="0 Б" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatDuration" Text="Анализ за 0.0 с" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Освобождено" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="StatFreedSize" Text="0 Б" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,0" />
                        <TextBlock x:Name="StatFreedCount" Text="Удалено объектов: 0" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Category Filters & Select All -->
            <DockPanel LastChildFill="False">
                <WrapPanel x:Name="FilterPanel" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll" Content="Все" Style="{StaticResource FilterPill}" IsChecked="True" Tag="All" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterTemp" Content="Временные и кэш" Style="{StaticResource FilterPill}" Tag="TempAndCache" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterDuplicates" Content="Дубликаты" Style="{StaticResource FilterPill}" Tag="Duplicates" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterEmpty" Content="Пустые" Style="{StaticResource FilterPill}" Tag="EmptyItems" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterLogs" Content="Логи" Style="{StaticResource FilterPill}" Tag="Logs" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterInstallers" Content="Установщики" Style="{StaticResource FilterPill}" Tag="Installers" Checked="FilterPill_Checked" />
                    <RadioButton x:Name="FilterLarge" Content="Крупные файлы" Style="{StaticResource FilterPill}" Tag="LargeFiles" Checked="FilterPill_Checked" />
                </WrapPanel>

                <CheckBox x:Name="SelectAllCheckBox"
                          DockPanel.Dock="Right"
                          Content="Выбрать все в списке"
                          VerticalAlignment="Center"
                          FontSize="12.5"
                          Foreground="{StaticResource TextSecondary}"
                          Click="SelectAllCheckBox_Click" />
            </DockPanel>
        </StackPanel>

        <!-- 4. Main Content Area -->
        <Border Grid.Row="4"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <!-- A. Welcome State (before scan) -->
                <StackPanel x:Name="WelcomeState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560"
                            Margin="24">
                    <TextBlock Text="🧹" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Готово к анализу"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Выберите любую папку выше и нажмите «Старт». Приложение проверит содержимое и подготовит список рекомендаций к очистке."
                               FontSize="13.5"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <UniformGrid Columns="3">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="🗑️ Временные и кэш" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text=".tmp, .bak, логи, кэш-папки, Thumbs.db" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="📑 Дубликаты и пустые" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Точные копии файлов, пустые файлы и папки" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="📦 Установщики и крупные" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Старые .msi/.exe и файлы от 50 МБ на проверку" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- B. Clean / Empty Results State -->
                <StackPanel x:Name="CleanState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            Margin="24">
                    <TextBlock Text="✅" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="CleanStateTitle"
                               Text="Папка в отличном порядке!"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CleanStateSubtitle"
                               Text="Файлов для удаления в этой категории не найдено."
                               FontSize="13.5"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- C. Recommendations List -->
                <ListBox x:Name="RecommendationsList"
                         Visibility="Collapsed"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Padding="8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              Click="ItemCheckBox_Click" />

                                    <!-- File Info & Recommendation -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding ItemIcon}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="360"
                                                       ToolTip="{Binding FullPath}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{Binding BadgeBackground}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeForeground}" />
                                            </Border>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Recommendation}"
                                                   FontSize="12"
                                                   Foreground="#334155"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />

                                        <TextBlock Text="{Binding RelativePath}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Size & Date -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,14,0"
                                                MinWidth="82">
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ModifiedDisplay}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Row Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📂"
                                                ToolTip="Показать в Проводнике"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,6"
                                                Margin="0,0,6,0"
                                                Tag="{Binding}"
                                                Click="OpenInExplorer_Click" />
                                        <Button Content="Удалить"
                                                Style="{StaticResource RowDeleteButton}"
                                                IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBool}}"
                                                Tag="{Binding}"
                                                Click="DeleteSingleItem_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 5. Bottom Action Bar -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="BottomStatusText"
                       Grid.Column="0"
                       Text="Выберите папку и нажмите «Старт» для начала анализа."
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CleanAllButton"
                        Content="🗑️  Очистить всё"
                        Style="{StaticResource DangerButton}"
                        IsEnabled="False"
                        Click="CleanAllButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
